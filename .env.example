# Observabilidade com Opik (docs/tutorial/configuracao/observabilidade.md). Copie para .env e preencha.
# Opik Cloud: https://www.comet.com/opik/api/v1/private/otel
OBS_OTLP_ENDPOINT=
OPIK_API_KEY=
OPIK_WORKSPACE=
OBS_PROJECT=hackathon-synpower
# 1 desliga o envio
OBS_DISABLED=
# full ou metadata (metadata esvazia pedido e código dos traces)
OBS_CONTENT=full
OBS_ARTIFACT_MAX=20000
OBS_SPIKE=

{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh observability/adapters/hook.sh codex",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh observability/adapters/hook.sh codex",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ]
  }
}

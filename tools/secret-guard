#!/bin/sh
# Responde se um caminho ou um comando toca em arquivo de segredo.
# Saida 0 permite em silencio; saida 1 nega e imprime o motivo.
#
# LIMITACOES DECLARADAS. Este componente previne acidente, nao adversario
# determinado. Le o texto do comando, nunca o executa, e nao interpreta o
# shell: nao resolve indirecao por variavel nem substituicao de comando
# (`A=.env; cat $A`, `cat $(echo .env)`), nem detecta despejo de ambiente via
# invocador (`docker run alpine env`, `sudo env`). A lista de invocadores
# nunca fica completa, por isso nao existe aqui.
#
# Expansao de chave (`cat .e{n,m}v`) tambem fica fora: o `case` do shell, motor
# de casamento deste arquivo, nao a interpreta. Glob de pouquissimo literal
# (`cat .??v`) escapa do piso de 3 literais que a via inversa exige (ver
# `literais_suficientes`). Quem escreve essas formas sabe o que esta fazendo.
set -u
# Sem expansao de glob contra o disco: o veredito nao pode depender do conteudo
# do diretorio corrente.
set -f

RAIZ=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
POLITICA="${SECRET_GUARD_POLICY:-$RAIZ/config/secrets-deny.conf}"
POLITICA_COMANDO="${SECRET_GUARD_COMMAND_POLICY:-$RAIZ/config/secrets-command.conf}"
ALTERNATIVA="pergunte ao usuario o que precisa da configuracao; os nomes das variaveis ficam no .env.example"
MOTIVO_PADRAO=""
LIMPO=""
EXPANDIDO=""
APARADO=""
INVERSO=0

# A mensagem cita so o motivo da politica, nunca a palavra do comando, que
# pode carregar um segredo (ex.: TOKEN=glpat-... na frente do comando).
negar() {
  printf 'Acesso negado pela politica de segredos: %s. %s\n' "$1" "$ALTERNATIVA"
  exit 1
}

# Falha fechada: politica ausente, ilegivel ou que nao e arquivo comum nega
# tudo em vez de permitir tudo.
exigir_politica() {
  [ -f "$1" ] && [ -r "$1" ] && return 0
  negar "politica ausente, ilegivel ou nao e arquivo comum ($1)"
}

# Tira espaco e tabulacao das duas pontas: sem isso um padrao com espaco a
# direita fica inerte, porque o espaco entra no glob.
aparar() {
  texto=$1
  while :; do
    case $texto in
      ' '*) texto=${texto# } ;;
      '	'*) texto=${texto#	} ;;
      *' ') texto=${texto% } ;;
      *'	') texto=${texto%	} ;;
      *) break ;;
    esac
  done
  APARADO=$texto
}

expandir_til() {
  case $1 in
    "~/"*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

absoluto() {
  case $1 in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PWD" "$1" ;;
  esac
}

# Substituicao unica de $HOME, ${HOME} e ~/. Sem laco: se HOME contiver a
# propria string "$HOME", repetir ate convergir travaria o gancho PreToolUse.
expandir_home() {
  texto=$1
  case $texto in
    *'${HOME}'*) texto=${texto%%'${HOME}'*}$HOME${texto#*'${HOME}'} ;;
  esac
  case $texto in
    *'$HOME'*) texto=${texto%%'$HOME'*}$HOME${texto#*'$HOME'} ;;
  esac
  case $texto in
    "~/"*) texto=$HOME/${texto#\~/} ;;
  esac
  EXPANDIDO=$texto
}

# Remove aspas simples e duplas do token, sem tr. A barra invertida so cai
# quando o token nao tinha aspas: `cat \.env` e acesso a arquivo, mas o
# `"\.env"` de um grep e texto literal de busca, nao caminho.
limpar_ruido() {
  texto=$1
  case $texto in
    *'"'*|*"'"*) set -- '"' "'" ;;
    *) set -- '"' "'" '\' ;;
  esac
  for c in "$@"; do
    acumulado=''
    while :; do
      case $texto in
        *"$c"*)
          acumulado=$acumulado${texto%%"$c"*}
          texto=${texto#*"$c"}
          ;;
        *) break ;;
      esac
    done
    texto=$acumulado$texto
  done
  LIMPO=$texto
}

# Modo --path: glob contra o caminho completo. Devolve 0 quando negado.
caminho_negado() {
  alvo=$1
  abs=$(absoluto "$alvo")
  negado=1
  # `|| [ -n ... ]` pega a ultima linha quando o arquivo nao termina em \n.
  while IFS= read -r linha || [ -n "$linha" ]; do
    aparar "$linha"
    linha=$APARADO
    case $linha in ''|\#*) continue ;; esac
    excecao=0
    case $linha in !*) excecao=1; linha=${linha#!} ;; esac
    padrao=$(expandir_til "$linha")
    casou=1
    case $abs in $padrao) casou=0 ;; esac
    case $alvo in $padrao) casou=0 ;; esac
    [ "$casou" -eq 0 ] || continue
    if [ "$excecao" -eq 1 ]; then
      negado=1
    else
      negado=0
      MOTIVO_PADRAO=$padrao
    fi
  done < "$POLITICA"
  return "$negado"
}

# literais_suficientes TOKEN -> devolve 0 quando o TOKEN, tirados os
# meta-caracteres * ? /, ainda tem 3 ou mais caracteres.
literais_suficientes() {
  texto=$1
  for c in '*' '?' '/'; do
    acumulado=''
    while :; do
      case $texto in
        *"$c"*)
          acumulado=$acumulado${texto%%"$c"*}
          texto=${texto#*"$c"}
          ;;
        *) break ;;
      esac
    done
    texto=$acumulado$texto
  done
  [ "${#texto}" -ge 3 ]
}

# Devolve 0 quando o sujeito (do token) casa com o padrao (da politica). Com
# INVERSO=1 tenta tambem a direcao contraria: `.en?` nao casa com `.env`, mas
# expande para ele no shell que roda o comando, entao precisa ser tratado como
# se casasse.
casa() {
  case $1 in $2) return 0 ;; esac
  [ "$INVERSO" -eq 1 ] || return 1
  case $2 in $1) return 0 ;; esac
  return 1
}

# Modo --command. A forma da linha da politica escolhe o casamento: terminada
# em barra casa qualquer COMPONENTE do caminho, com barra no meio casa o
# CAMINHO COMPLETO, sem barra casa o BASENAME. Nunca com prefixo $PWD. Devolve
# 0 quando o token e negado.
token_negado() {
  alvo=$1
  # Barra final nao muda o alvo: `.env/` = `.env`.
  while :; do
    case $alvo in
      */) alvo=${alvo%/} ;;
      *) break ;;
    esac
  done
  [ -n "$alvo" ] || return 1
  base=${alvo##*/}
  # Basename COMECANDO com * ou ? e padrao escrito por quem chamou, nao caminho
  # concreto (`find . -name '*.pem'` pede um glob ao find, nao abre arquivo).
  # Glob no meio de um nome concreto (`.en?`) e outra coisa: expande para um
  # arquivo de verdade, e continua sendo casado pela via inversa.
  case $base in
    '*'*|'?'*) return 1 ;;
  esac
  tem_glob=0
  case $alvo in
    *'*'*|*'?'*|*'['*) tem_glob=1 ;;
  esac
  # A via inversa so vale com pelo menos 3 caracteres literais (tirados * ? /):
  # sem esse piso, um token quase todo glob (".*", 1 literal) vira um padrao
  # tao largo que casa com ".aws", ".ssh" e quase qualquer linha da politica.
  # 3 e o minimo que ainda mantem presos ".en?" e ".en*" (literais ".", "e",
  # "n"). Teto conhecido: ".??v", ".?n?", ".e??" (2 literais) escapam da via
  # inversa mesmo expandindo para ".env" de verdade -- ver LIMITACOES
  # DECLARADAS no cabecalho.
  #
  # Colchete entra na deteccao junto com "*" e "?" porque ".en[v]" e glob de
  # caminho igual a ".en?" e expande para ".env"; sem isso "tem_glob" ficaria
  # 0 e o token passaria livre por qualquer quantidade de literais.
  via_inversa=0
  if [ "$tem_glob" -eq 1 ] && literais_suficientes "$alvo"; then
    via_inversa=1
  fi
  negado=1
  while IFS= read -r linha || [ -n "$linha" ]; do
    aparar "$linha"
    linha=$APARADO
    case $linha in ''|\#*) continue ;; esac
    excecao=0
    case $linha in !*) excecao=1; linha=${linha#!} ;; esac
    # A via inversa vale so para linha de negacao: deixar excecao casar por ela
    # abriria `cat .env.*` pela excecao de .env.example.
    if [ "$excecao" -eq 1 ]; then INVERSO=0; else INVERSO=$via_inversa; fi
    casou=1
    case $linha in
      */)
        componente=${linha%/}
        resto=$alvo
        while :; do
          casa "${resto%%/*}" "$componente" && casou=0
          case $resto in
            */*) resto=${resto#*/} ;;
            *) break ;;
          esac
        done
        ;;
      */*)
        casa "$alvo" "$linha" && casou=0
        ;;
      *)
        casa "$base" "$linha" && casou=0
        ;;
    esac
    [ "$casou" -eq 0 ] || continue
    if [ "$excecao" -eq 1 ]; then
      negado=1
    else
      negado=0
      MOTIVO_PADRAO=$linha
    fi
  done < "$POLITICA_COMANDO"
  return "$negado"
}

# Devolve 0 quando a palavra tem a forma NOME=valor de atribuicao de ambiente.
eh_atribuicao() {
  case ${1:-} in
    ''|=*) return 1 ;;
    *=*) ;;
    *) return 1 ;;
  esac
  nome=${1%%=*}
  case $nome in
    [0-9]*) return 1 ;;
    *[!A-Za-z0-9_]*) return 1 ;;
  esac
  return 0
}

# Analisa um segmento ja separado.
analisar_segmento() {
  seg=$1
  set -- $seg
  # Limpa aspas de cada token, descartando os que ficam vazios.
  restantes=$#
  while [ "$restantes" -gt 0 ]; do
    limpar_ruido "$1"
    shift
    [ -n "$LIMPO" ] && set -- "$@" "$LIMPO"
    restantes=$((restantes - 1))
  done

  # Todo token e caminho candidato, inclusive flags.
  for token in "$@"; do
    expandir_home "$token"
    token_negado "$EXPANDIDO" && negar "casa com o padrao $MOTIVO_PADRAO"
  done

  # Despejo de ambiente so quando a palavra e a PRIMEIRA do segmento, pulando
  # apenas as atribuicoes NOME=valor que a precedem e comparando pelo basename,
  # para pegar a forma com caminho absoluto. Nada alem disso: nao ha lista de
  # invocadores, e a limitacao que isso deixa aberta esta declarada no cabecalho.
  while [ "$#" -gt 0 ] && eh_atribuicao "$1"; do
    shift
  done
  [ "$#" -gt 0 ] || return 0
  proxima=${2:-}
  case ${1##*/} in
    printenv)
      negar "despejo de ambiente pela primeira palavra printenv"
      ;;
    env)
      # env NOME=valor comando e uso legitimo de prefixo e continua passando.
      eh_atribuicao "$proxima" ||
        negar "despejo de ambiente pela primeira palavra env"
      ;;
    export)
      case " $* " in
        *" -p "*) negar "despejo de ambiente por export -p" ;;
      esac
      ;;
    set)
      [ "$#" -eq 1 ] && negar "despejo de ambiente pela primeira palavra set"
      ;;
  esac
  return 0
}

exigir_politica "$POLITICA"
exigir_politica "$POLITICA_COMANDO"

[ "${1:-}" = "check" ] || { printf 'uso: secret-guard check --path CAMINHO | --command COMANDO\n' >&2; exit 2; }
shift

case "${1:-}" in
  --path)
    # O contrato so preve 0 e 1: alvo vazio ou ausente nega, nao vira erro de uso.
    alvo=${2-}
    [ -n "$alvo" ] || negar "caminho vazio"
    expandir_home "$alvo"
    caminho_negado "$EXPANDIDO" && negar "casa com o padrao $MOTIVO_PADRAO"
    exit 0
    ;;
  --command)
    comando=${2-}
    [ -n "$comando" ] || negar "comando vazio"
    # Separadores de segmento: | ; & ( ) e nova linha. Chave nao entra: ela
    # aparece dentro de aspas em uso comum, como `awk '{print}'`, e `{ ...; }`
    # ja se separa pelo ; ou pela nova linha que a forma exige.
    segmentado=$(printf '%s\n' "$comando" | sed 's/[|;&()]/\
/g')
    while IFS= read -r segmento; do
      analisar_segmento "$segmento"
    done <<EOF
$segmentado
EOF
    exit 0
    ;;
  *)
    printf 'uso: secret-guard check --path CAMINHO | --command COMANDO\n' >&2
    exit 2
    ;;
esac

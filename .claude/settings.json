{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/observability/adapters/hook.sh\" claude-code",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/observability/adapters/hook.sh\" claude-code",
            "async": true,
            "timeout": 8
          }
        ]
      }
    ]
  }
}
